#!/usr/bin/env python3
# production/signal_generator/filter_funnel.py
#
# Daily diagnostic — shows how many symbols passed each filter
# stage for both active strategies.
#
# Run after market close:
#   cd ~/trading/Bollinger
#   python3 -m production.signal_generator.filter_funnel
#
# Optional: pass a date to analyse a specific day:
#   python3 -m production.signal_generator.filter_funnel 2026-03-17

from __future__ import annotations

import os
import sys
from datetime import date

import polars as pl

ASSEMBLED_DIR = "assembled_candles"

# ── Shared indicator config ───────────────────────────────────────────────────
BB_PERIOD  = 20
BB_STD     = 2.0
RSI_PERIOD = 14
ATR_PERIOD = 14

# ── Strategy configs ──────────────────────────────────────────────────────────
# near_bb_min:  show symbols with bb_width just below the threshold
# near_atr_*:   show symbols with atr just outside the valid range
# near_rsi_*:   show symbols with rsi just outside the valid range (direction-aware)
STRATEGIES = {
    "mean_reversion_short": {
        "bb_width_min": 0.05,
        "atr_pct_min":  1.0,
        "atr_pct_max":  2.0,
        "rsi_min":      55,
        "rsi_max":      80,
        "vwap_atr_max": 1.25,
        "ema5_required": None,
        "time_windows": [(9,30,10,45), (14,0,15,5)],
        # near-miss ranges (direction-aware)
        "near_bb_min":      0.045,    # bb just below min threshold
        "near_atr_low_min": 0.8,     # atr just below min (0.8–1.0)
        "near_atr_low_max": 1.0,
        "near_atr_high_min": 2.0,    # atr just above max (2.0–2.5)
        "near_atr_high_max": 2.5,
        "near_rsi_low_min": 50,      # rsi just below min (50–55)
        "near_rsi_low_max": 55,
        "near_rsi_high_min": 80,     # rsi just above max (80–85)
        "near_rsi_high_max": 85,
    },
    "mb_crossover_long": {
        "bb_width_min": 0.05,
        "atr_pct_min":  0.5,
        "atr_pct_max":  1.0,
        "rsi_min":      30,
        "rsi_max":      50,
        "vwap_atr_max": None,
        "ema5_required": "above",
        "time_windows": [(9,45,10,50)],
        # near-miss ranges (direction-aware)
        "near_bb_min":      0.045,    # bb just below min threshold
        "near_atr_low_min": 0.3,     # atr just below min (0.3–0.5)
        "near_atr_low_max": 0.5,
        "near_atr_high_min": 1.0,    # atr just above max (1.0–1.3)
        "near_atr_high_max": 1.3,
        "near_rsi_low_min": 25,      # rsi just below min (25–30)
        "near_rsi_low_max": 30,
        "near_rsi_high_min": 50,     # rsi just above max (50–55)
        "near_rsi_high_max": 55,
    },
}


def in_windows(h: int, m: int, windows: list) -> bool:
    for (sh, sm, eh, em) in windows:
        if (sh, sm) <= (h, m) <= (eh, em):
            return True
    return False


def compute_indicators(df: pl.DataFrame) -> pl.DataFrame | None:
    if df.is_empty() or df.height < 5:
        return None

    close = pl.col("close")
    lf = df.lazy()

    # Bollinger Bands
    lf = lf.with_columns([
        close.rolling_mean(min(BB_PERIOD, df.height)).alias("mb"),
        close.rolling_std(min(BB_PERIOD, df.height)).alias("std"),
    ]).with_columns([
        (pl.col("mb") + BB_STD * pl.col("std")).alias("ub"),
        (pl.col("mb") - BB_STD * pl.col("std")).alias("lb"),
    ]).with_columns(
        ((pl.col("ub") - pl.col("lb")) / pl.col("mb")).alias("bb_width")
    )

    # RSI simple rolling (mean_reversion_short)
    lf = lf.with_columns(
        (close - close.shift(1)).alias("delta")
    ).with_columns([
        pl.when(pl.col("delta") > 0)
          .then(pl.col("delta")).otherwise(0)
          .rolling_mean(min(RSI_PERIOD, df.height))
          .alias("avg_gain"),
        pl.when(pl.col("delta") < 0)
          .then(-pl.col("delta")).otherwise(0)
          .rolling_mean(min(RSI_PERIOD, df.height))
          .alias("avg_loss"),
    ]).with_columns(
        (100 - (100 / (1 + pl.col("avg_gain") / pl.col("avg_loss")))).alias("rsi_simple")
    )

    # RSI Wilder ewm (mb_crossover_long)
    lf = lf.with_columns([
        pl.when(pl.col("delta") > 0)
          .then(pl.col("delta")).otherwise(0)
          .ewm_mean(alpha=1/RSI_PERIOD, adjust=False)
          .alias("avg_gain_w"),
        pl.when(pl.col("delta") < 0)
          .then(-pl.col("delta")).otherwise(0)
          .ewm_mean(alpha=1/RSI_PERIOD, adjust=False)
          .alias("avg_loss_w"),
    ]).with_columns(
        pl.when(pl.col("avg_loss_w") > 0)
          .then(100 - (100 / (1 + pl.col("avg_gain_w") / pl.col("avg_loss_w"))))
          .otherwise(100)
          .alias("rsi_wilder")
    )

    # ATR
    lf = lf.with_columns(
        pl.max_horizontal(
            pl.col("high") - pl.col("low"),
            (pl.col("high") - close.shift()).abs(),
            (pl.col("low")  - close.shift()).abs(),
        ).rolling_mean(min(ATR_PERIOD, df.height)).alias("atr")
    ).with_columns(
        (pl.col("atr") / close * 100).alias("atr_pct")
    )

    # VWAP + VWAP/ATR (mean_reversion_short)
    lf = lf.with_columns(
        pl.col("datetime").dt.date().alias("trade_date")
    ).with_columns(
        (
            (pl.col("close") * pl.col("volume")).cum_sum().over("trade_date") /
            pl.col("volume").cum_sum().over("trade_date")
        ).alias("vwap")
    ).with_columns(
        ((pl.col("close") - pl.col("vwap")) / pl.col("atr")).alias("vwap_atr")
    )

    # EMA5 (mb_crossover_long)
    lf = lf.with_columns(
        close.ewm_mean(span=5, adjust=False).alias("ema5")
    ).with_columns(
        (close > pl.col("ema5")).alias("above_ema5")
    )

    return lf.collect()


def analyse_symbol(path: str, trade_date: date, cfg: dict, rsi_col: str) -> dict | None:
    try:
        df = (
            pl.read_parquet(path)
            .sort("datetime")
            .filter(pl.col("datetime").dt.date() == trade_date)
        )
        result = compute_indicators(df)
        if result is None:
            return None

        # Filter to time windows
        time_rows = result.filter(
            pl.struct(
                pl.col("datetime").dt.hour().alias("h"),
                pl.col("datetime").dt.minute().alias("m"),
            ).map_elements(
                lambda s: in_windows(s["h"], s["m"], cfg["time_windows"]),
                return_dtype=pl.Boolean,
            )
        )
        if time_rows.is_empty():
            return None

        bb_max   = float(time_rows["bb_width"].max() or 0)
        atr_max  = float(time_rows["atr_pct"].max() or 0)
        atr_min  = float(time_rows["atr_pct"].min() or 0)
        rsi_vals = time_rows[rsi_col].drop_nulls()
        rsi_last = float(rsi_vals[-1]) if len(rsi_vals) > 0 else 0

        bb_pass   = bb_max >= cfg["bb_width_min"]
        atr_pass  = time_rows.filter(
            (pl.col("atr_pct") >= cfg["atr_pct_min"]) &
            (pl.col("atr_pct") <= cfg["atr_pct_max"])
        ).height > 0
        rsi_pass  = time_rows.filter(
            (pl.col(rsi_col) >= cfg["rsi_min"]) &
            (pl.col(rsi_col) <= cfg["rsi_max"])
        ).height > 0
        vwap_pass = True
        if cfg["vwap_atr_max"] is not None:
            vwap_pass = time_rows.filter(
                pl.col("vwap_atr") <= cfg["vwap_atr_max"]
            ).height > 0
        ema5_pass = True
        if cfg["ema5_required"] == "above":
            ema5_pass = time_rows.filter(pl.col("above_ema5")).height > 0

        return {
            "bb_pass":   bb_pass,
            "atr_pass":  atr_pass,
            "rsi_pass":  rsi_pass,
            "vwap_pass": vwap_pass,
            "ema5_pass": ema5_pass,
            "all_pass":  bb_pass and atr_pass and rsi_pass and vwap_pass and ema5_pass,
            "bb_max":    bb_max,
            "atr_max":   atr_max,
            "atr_min":   atr_min,
            "rsi_last":  rsi_last,
        }
    except Exception:
        return None


def run_strategy(files: list, trade_date: date, name: str, cfg: dict, rsi_col: str):
    counts = {k: 0 for k in ["has_data","bb_pass","atr_pass","rsi_pass","vwap_pass","ema5_pass","all_pass"]}
    near_bb       = []  # bb just below min
    near_atr_low  = []  # atr just below min
    near_atr_high = []  # atr just above max
    near_rsi_low  = []  # rsi just below min
    near_rsi_high = []  # rsi just above max
    candidates    = []

    for fname in sorted(files):
        symbol = fname.replace(".parquet", "")
        if symbol == "NIFTY50":
            continue

        result = analyse_symbol(
            os.path.join(ASSEMBLED_DIR, fname), trade_date, cfg, rsi_col
        )
        if result is None:
            continue

        counts["has_data"] += 1
        for k in ["bb_pass","atr_pass","rsi_pass","vwap_pass","ema5_pass","all_pass"]:
            if result[k]:
                counts[k] += 1

        # BB near miss — just below min
        if not result["bb_pass"] and result["bb_max"] >= cfg["near_bb_min"]:
            near_bb.append((symbol, round(result["bb_max"], 4)))

        # ATR near misses — direction aware
        if not result["atr_pass"]:
            if cfg["near_atr_low_min"] <= result["atr_max"] < cfg["near_atr_low_max"]:
                near_atr_low.append((symbol, round(result["atr_max"], 2)))
            if cfg["near_atr_high_min"] < result["atr_max"] <= cfg["near_atr_high_max"]:
                near_atr_high.append((symbol, round(result["atr_max"], 2)))

        # RSI near misses — direction aware
        if not result["rsi_pass"]:
            if cfg["near_rsi_low_min"] <= result["rsi_last"] < cfg["near_rsi_low_max"]:
                near_rsi_low.append((symbol, round(result["rsi_last"], 1)))
            if cfg["near_rsi_high_min"] < result["rsi_last"] <= cfg["near_rsi_high_max"]:
                near_rsi_high.append((symbol, round(result["rsi_last"], 1)))

        if result["all_pass"]:
            candidates.append((symbol, round(result["bb_max"],4), round(result["atr_max"],2), round(result["rsi_last"],1)))

    n   = max(counts["has_data"], 1)
    pct = lambda v: f"{v/n*100:.1f}%"

    print(f"\n{'─'*65}")
    print(f"  {name.upper()}")
    print(f"{'─'*65}")
    print(f"  Symbols with data    : {counts['has_data']:5d}    100.0%")
    print(f"  BB width >= {cfg['bb_width_min']}    : {counts['bb_pass']:5d}    {pct(counts['bb_pass'])}")
    print(f"  ATR {cfg['atr_pct_min']}–{cfg['atr_pct_max']}%           : {counts['atr_pass']:5d}    {pct(counts['atr_pass'])}")
    print(f"  RSI {cfg['rsi_min']}–{cfg['rsi_max']}             : {counts['rsi_pass']:5d}    {pct(counts['rsi_pass'])}")
    if cfg["vwap_atr_max"] is not None:
        print(f"  VWAP/ATR <= {cfg['vwap_atr_max']}      : {counts['vwap_pass']:5d}    {pct(counts['vwap_pass'])}")
    if cfg["ema5_required"]:
        print(f"  Above EMA5           : {counts['ema5_pass']:5d}    {pct(counts['ema5_pass'])}")
    print(f"{'─'*65}")
    print(f"  ALL filters passed   : {counts['all_pass']:5d}    {pct(counts['all_pass'])}")
    print(f"{'─'*65}")

    if candidates:
        print(f"\n  ✅ CANDIDATES ({len(candidates)}):")
        print(f"  {'Symbol':<15} {'BB width':>10} {'ATR%':>8} {'RSI':>8}")
        print(f"  {'─'*43}")
        for sym, bb, atr, rsi in sorted(candidates, key=lambda x: x[1], reverse=True):
            print(f"  {sym:<15} {bb:>10} {atr:>8} {rsi:>8}")
    else:
        print(f"\n  ⚪ No candidates today")

    print(f"\n  📊 Near misses (closest to threshold):")

    # BB
    near_bb.sort(key=lambda x: x[1], reverse=True)
    print(f"  BB width (need >= {cfg['bb_width_min']}, showing {cfg['near_bb_min']}–{cfg['bb_width_min']}):")
    if near_bb[:6]:
        for sym, val in near_bb[:6]:
            bar = "█" * int(val / cfg["bb_width_min"] * 20)
            print(f"    {sym:<15} {val:.4f}  {bar}")
    else:
        print(f"    None in range")

    # ATR below min
    near_atr_low.sort(key=lambda x: x[1], reverse=True)
    print(f"  ATR just below min (need >= {cfg['atr_pct_min']}%, showing {cfg['near_atr_low_min']}–{cfg['near_atr_low_max']}%):")
    if near_atr_low[:6]:
        for sym, val in near_atr_low[:6]:
            print(f"    {sym:<15} {val:.2f}%")
    else:
        print(f"    None in range")

    # ATR above max
    near_atr_high.sort(key=lambda x: x[1])
    print(f"  ATR just above max (need <= {cfg['atr_pct_max']}%, showing {cfg['near_atr_high_min']}–{cfg['near_atr_high_max']}%):")
    if near_atr_high[:6]:
        for sym, val in near_atr_high[:6]:
            print(f"    {sym:<15} {val:.2f}%")
    else:
        print(f"    None in range")

    # RSI below min
    near_rsi_low.sort(key=lambda x: x[1], reverse=True)
    print(f"  RSI just below min (need >= {cfg['rsi_min']}, showing {cfg['near_rsi_low_min']}–{cfg['near_rsi_low_max']}):")
    if near_rsi_low[:6]:
        for sym, val in near_rsi_low[:6]:
            print(f"    {sym:<15} {val:.1f}")
    else:
        print(f"    None in range")

    # RSI above max
    near_rsi_high.sort(key=lambda x: x[1])
    print(f"  RSI just above max (need <= {cfg['rsi_max']}, showing {cfg['near_rsi_high_min']}–{cfg['near_rsi_high_max']}):")
    if near_rsi_high[:6]:
        for sym, val in near_rsi_high[:6]:
            print(f"    {sym:<15} {val:.1f}")
    else:
        print(f"    None in range")


def run(trade_date: date):
    print(f"\n{'='*65}")
    print(f"  FILTER FUNNEL REPORT — {trade_date}")
    print(f"{'='*65}")

    files = [f for f in os.listdir(ASSEMBLED_DIR) if f.endswith(".parquet")]

    run_strategy(files, trade_date, "mean_reversion_short",
                 STRATEGIES["mean_reversion_short"], rsi_col="rsi_simple")

    run_strategy(files, trade_date, "mb_crossover_long",
                 STRATEGIES["mb_crossover_long"], rsi_col="rsi_wilder")

    print(f"\n{'='*65}\n")


if __name__ == "__main__":
    if len(sys.argv) > 1:
        try:
            trade_date = date.fromisoformat(sys.argv[1])
        except ValueError:
            print(f"❌ Invalid date format: {sys.argv[1]} — use YYYY-MM-DD")
            sys.exit(1)
    else:
        trade_date = date.today()

    run(trade_date)

