# ══════════════════════════════════════════════════════════════════════════════
#  BLACK-SCHOLES
# ══════════════════════════════════════════════════════════════════════════════

def bs_price(S, K, T, r, sigma, opt_type):
    if T <= 0 or sigma <= 0:
        intrinsic = max(S - K, 0) if opt_type == "CE" else max(K - S, 0)
        return intrinsic, (1.0 if opt_type == "CE" else -1.0), 0.0, 0.0, 0.0
    d1  = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))
    d2  = d1 - sigma * np.sqrt(T)
    nd1 = norm.cdf(d1);  nd2  = norm.cdf(d2)
    nd1n = norm.cdf(-d1); nd2n = norm.cdf(-d2)
    pdf_d1 = norm.pdf(d1)
    if opt_type == "CE":
        price = S * nd1 - K * np.exp(-r * T) * nd2
        delta = nd1
    else:
        price = K * np.exp(-r * T) * nd2n - S * nd1n
        delta = nd1 - 1
    gamma = pdf_d1 / (S * sigma * np.sqrt(T))
    theta = (-(S * pdf_d1 * sigma) / (2 * np.sqrt(T))
             - r * K * np.exp(-r * T) * (nd2 if opt_type == "CE" else nd2n)) / 365
    vega  = S * pdf_d1 * np.sqrt(T) / 100
    return max(price, 0), delta, gamma, theta, vega


def iv_surface(S, K, dte, vix_val, opt_type):
    base      = vix_val / 100 if vix_val > 1 else vix_val
    if base <= 0:
        base = C.BASE_IV
    moneyness = np.log(K / S) if S > 0 else 0
    skew = (C.PUT_SKEW  * max(0, -moneyness) * 100 if opt_type == "PE"
            else C.CALL_SKEW * max(0,  moneyness) * 100)
    bump = C.SHORT_DTE_BUMP if dte < 2 else 0.0
    return max(base + skew + bump, 0.05)


# ══════════════════════════════════════════════════════════════════════════════
#  HELPERS
# ══════════════════════════════════════════════════════════════════════════════

def now_ist() -> datetime:
    return datetime.now(IST).replace(tzinfo=None)


def ist_time() -> time:
    return now_ist().time()


def next_thursday(d: date) -> date:
    while d.weekday() != 3:
        d = date(d.year, d.month, d.day + 1) if d.day < 28 else \
            (d.replace(day=d.day + 1) if True else d)
    # use timedelta to be safe
    from datetime import timedelta
    dt = datetime.combine(d, datetime.min.time())
    while dt.weekday() != 3:
        dt += timedelta(days=1)
    return dt.date()


def atm_strike(spot: float) -> int:
    return int(round(spot / C.STRIKE_STEP) * C.STRIKE_STEP)


# ── VIX sourcing ─────────────────────────────────────────────────────────────
# No CSV files. VIX fetched live from Kite every poll cycle.
# Stored in memory as a rolling time-series for the current day.
# Falls back to BASE_IV if Kite unavailable.

VIX_TOKEN = 264969   # India VIX instrument token on Kite

_kite_instance = None

def _get_kite():
    """Lazy-init Kite connection using env vars from .env.kite"""
    global _kite_instance
    if _kite_instance is not None:
        return _kite_instance
    try:
        from kiteconnect import KiteConnect
        api_key      = os.environ.get("KITE_API_KEY", "")
        access_token = os.environ.get("KITE_ACCESS_TOKEN", "")
        if not api_key or not access_token:
            log.warning("[VIX] KITE_API_KEY / KITE_ACCESS_TOKEN not set")
            return None
        k = KiteConnect(api_key=api_key)
        k.set_access_token(access_token)
        _kite_instance = k
        log.info("[VIX] Kite connection initialised")
        return k
    except Exception as e:
        log.warning(f"[VIX] Kite init failed: {e}")
        return None


class VIXCache:
    """
    In-memory VIX cache. Refreshed every poll cycle.
    Stores timestamped readings for the current trading day.
    On a new day the cache resets automatically.
    """

    def __init__(self):
        self._cache: list[tuple[datetime, float]] = []
        self._today: date | None = None
        self._last_value: float  = C.BASE_IV * 100

    def refresh(self):
        """Fetch latest VIX from Kite and store in memory."""
        today = date.today()

        # Reset cache on new day
        if self._today != today:
            self._cache = []
            self._today = today
            log.info(f"[VIX] Cache reset for new day {today}")

        try:
            kite = _get_kite()
            if kite is None:
                return
            quote = kite.ltp([VIX_TOKEN])
            if quote:
                val = list(quote.values())[0].get("last_price", 0)
                if val > 0:
                    ts = now_ist()
                    self._cache.append((ts, float(val)))
                    self._last_value = float(val)
                    log.debug(f"[VIX] {val:.2f} cached at {ts.strftime('%H:%M:%S')}")
        except Exception as e:
            log.warning(f"[VIX] Refresh failed: {e} — using last={self._last_value:.2f}",exc_info=True)

    def get(self, at: datetime | None = None) -> float:
        """
        Get VIX value at a specific time (or latest if at=None).
        Searches cache for closest reading <= at.
        Falls back to last known value, then BASE_IV.
        """
        if not self._cache:
            return self._last_value if self._last_value else C.BASE_IV * 100

        if at is None:
            return self._cache[-1][1]

        # Find last reading at or before requested time
        prior = [(ts, v) for ts, v in self._cache if ts <= at]
        if prior:
            return prior[-1][1]

        # at is before first reading — use first available
        return self._cache[0][1]

    @property
    def last(self) -> float:
        return self._last_value if self._last_value else C.BASE_IV * 100


def compute_atr(df: pd.DataFrame) -> float:
    """Compute latest ATR% from last ATR_PERIOD+1 5M candles."""
    if len(df) < 2:
        return 0.0
    prev_close = df["close"].shift(1)
    tr = pd.concat([
        (df["high"] - df["low"]),
        (df["high"] - prev_close).abs(),
        (df["low"]  - prev_close).abs(),
    ], axis=1).max(axis=1)
    atr = tr.ewm(span=C.ATR_PERIOD, adjust=False).mean().iloc[-1]
    return float(atr / df["close"].iloc[-1] * 100)


def load_nifty_candles() -> pd.DataFrame:
    """Read NIFTY50.parquet via polars (fast), return pandas DataFrame."""
    try:
        df = pl.read_parquet(C.NIFTY_PARQUET).to_pandas()
        df.columns = [c.lower() for c in df.columns]

        # Ensure datetime index
        if "date" in df.columns:
            df = df.rename(columns={"date": "datetime"})
        df["datetime"] = pd.to_datetime(df["datetime"])
        if df["datetime"].dt.tz is not None:
            df["datetime"] = df["datetime"].dt.tz_localize(None)
        df = df.set_index("datetime").sort_index()
        return df
    except Exception as e:
        log.error(f"Failed to load NIFTY50.parquet: {e}")
        return pd.DataFrame()


# ══════════════════════════════════════════════════════════════════════════════
#  ORB SIGNAL ENGINE
# ══════════════════════════════════════════════════════════════════════════════

class ORBSignal:
    """
    Stateful ORB signal tracker for a single trading day.
    Reset on each new trading day.
    """

    def __init__(self):
        self.today        = None
        self.orb_high     = None
        self.orb_low      = None
        self.orb_range_pct = None
        self.orb_formed   = False
        self.signal_fired = False
        self.regime       = None
        self.prior_range  = None
        log.info("[ORBSignal] Initialised.")

    def _reset_day(self, today: date, df: pd.DataFrame):
        """Called at start of each new trading day."""
        self.today        = today
        self.orb_high     = None
        self.orb_low      = None
        self.orb_range_pct = None
        self.orb_formed   = False
        self.signal_fired = False

        # Compute regime from daily closes (20D EMA)
        daily_close = df["close"].resample("1D").last().dropna()
        daily_close.index = daily_close.index.normalize()
        if len(daily_close) >= C.REGIME_EMA_PERIOD:
            ema = daily_close.ewm(span=C.REGIME_EMA_PERIOD, adjust=False).mean()
            prior = ema[ema.index.date < today]
            prior_close = daily_close[daily_close.index.date < today]
            if not prior.empty and not prior_close.empty:
                self.regime = "bull" if prior_close.iloc[-1] > prior.iloc[-1] else "bear"
            else:
                self.regime = None
        else:
            self.regime = None

        # Compute prior day range %
        daily_high  = df["high"].resample("1D").max().dropna()
        daily_low   = df["low"].resample("1D").min().dropna()
        daily_close2 = df["close"].resample("1D").last().dropna()
        daily_high.index  = daily_high.index.normalize()
        daily_low.index   = daily_low.index.normalize()
        daily_close2.index = daily_close2.index.normalize()

        prev_high  = daily_high[daily_high.index.date < today]
        prev_low   = daily_low[daily_low.index.date < today]
        prev_close = daily_close2[daily_close2.index.date < today]

        if not prev_high.empty and not prev_low.empty and not prev_close.empty:
            self.prior_range = float(
                (prev_high.iloc[-1] - prev_low.iloc[-1]) / prev_close.iloc[-1] * 100
            )
        else:
            self.prior_range = None

        log.info(
            f"[ORBSignal] New day {today} | regime={self.regime} "
            f"| prior_range={self.prior_range:.3f}%" if self.prior_range else
            f"[ORBSignal] New day {today} | regime={self.regime} | prior_range=None"
        )

        # Restore state from DB in case of restart
        state = get_orb_state(today)
        if state:
            self.orb_high      = float(state["orb_high"])  if state["orb_high"]  else None
            self.orb_low       = float(state["orb_low"])   if state["orb_low"]   else None
            self.orb_range_pct = float(state["orb_range_pct"]) if state["orb_range_pct"] else None
            self.orb_formed    = bool(state["orb_formed"])
            self.signal_fired  = bool(state["signal_fired"])
            if self.orb_formed:
                log.info(
                    f"[ORBSignal] Restored state from DB: ORB {self.orb_low:.2f}–{self.orb_high:.2f} "
                    f"| signal_fired={self.signal_fired}"
                )

    def check(self, df: pd.DataFrame) -> dict | None:
        """
        Main check — called every poll cycle.
        Returns signal dict if entry conditions met, else None.
        """
        today = now_ist().date()

        # New day reset
        if self.today != today:
            self._reset_day(today, df)

        if self.signal_fired:
            return None

        t = ist_time()

        # Pre-market or too late
        if t < C.MARKET_OPEN or t >= C.ENTRY_CUTOFF_TIME:
            return None

        # Filter today's candles
        today_df = df[df.index.date == today].copy()
        if today_df.empty:
            return None

        # ── Form ORB ──────────────────────────────────────────────────────────
        if not self.orb_formed:
            if t < C.ORB_END_TIME:
                return None   # Still forming

            orb_bars = today_df[today_df.index.time <= C.ORB_END_TIME]
            if orb_bars.empty:
                return None

            self.orb_high = float(orb_bars["high"].max())
            self.orb_low  = float(orb_bars["low"].min())
            last_close    = float(orb_bars["close"].iloc[-1])
            self.orb_range_pct = (self.orb_high - self.orb_low) / last_close * 100

            # ORB range filter
            if not (C.ORB_RANGE_MIN_PCT <= self.orb_range_pct <= C.ORB_RANGE_MAX_PCT):
                log.info(
                    f"[ORBSignal] ORB range {self.orb_range_pct:.3f}% "
                    f"outside [{C.ORB_RANGE_MIN_PCT}, {C.ORB_RANGE_MAX_PCT}] — skip day"
                )
                self.signal_fired = True   # no signal today
                return None

            # Prior day range filter
            if self.prior_range is None or self.prior_range >= C.PRIOR_DAY_RANGE_MAX:
                log.info(
                    f"[ORBSignal] Prior day range {self.prior_range}% "
                    f">= {C.PRIOR_DAY_RANGE_MAX}% — skip day"
                )
                self.signal_fired = True
                return None

            # Regime filter
            if self.regime is None:
                log.info("[ORBSignal] Regime unknown — skip day")
                self.signal_fired = True
                return None

            self.orb_formed = True
            log.info(
                f"[ORBSignal] ORB formed: HIGH={self.orb_high:.2f} "
                f"LOW={self.orb_low:.2f} range={self.orb_range_pct:.3f}% "
                f"| regime={self.regime}"
            )
            upsert_orb_state({
                "trade_date":    today,
                "orb_high":      self.orb_high,
                "orb_low":       self.orb_low,
                "orb_range_pct": self.orb_range_pct,
                "orb_formed":    True,
                "signal_fired":  False,
                "direction":     None,
                "regime":        self.regime,
            })

        # ── Watch for breakout ────────────────────────────────────────────────
        post_orb = today_df[today_df.index.time > C.ORB_END_TIME]
        if post_orb.empty:
            return None

        latest      = post_orb.iloc[-1]
        latest_close = float(latest["close"])
        direction   = None

        if latest_close > self.orb_high:
            direction = "CE"
        elif latest_close < self.orb_low:
            direction = "PE"

        if direction is None:
            return None

        # Regime direction filter
        if direction == "CE" and self.regime != "bull":
            log.info(f"[ORBSignal] CE signal but regime={self.regime} — skip")
            self.signal_fired = True
            return None
        if direction == "PE" and self.regime != "bear":
            log.info(f"[ORBSignal] PE signal but regime={self.regime} — skip")
            self.signal_fired = True
            return None

        # ATR filter
        atr_pct = compute_atr(today_df.tail(C.ATR_PERIOD + 5))
        if atr_pct < C.ATR_MIN_PCT:
            log.info(f"[ORBSignal] ATR {atr_pct:.4f}% < {C.ATR_MIN_PCT}% — skip")
            self.signal_fired = True
            return None

        self.signal_fired = True
        upsert_orb_state({
            "trade_date":    today,
            "orb_high":      self.orb_high,
            "orb_low":       self.orb_low,
            "orb_range_pct": self.orb_range_pct,
            "orb_formed":    True,
            "signal_fired":  True,
            "direction":     direction,
            "regime":        self.regime,
        })

        log.info(
            f"[ORBSignal] 🔔 SIGNAL {direction} | spot={latest_close:.2f} "
            f"| ATR={atr_pct:.4f}% | prior_range={self.prior_range:.3f}%"
        )

        return {
            "direction":           direction,
            "regime":              self.regime,
            "spot":                latest_close,
            "orb_high":            self.orb_high,
            "orb_low":             self.orb_low,
            "orb_range_pct":       self.orb_range_pct,
            "atr_pct":             atr_pct,
            "prior_day_range_pct": self.prior_range,
            "signal_time":         now_ist(),
        }


# ══════════════════════════════════════════════════════════════════════════════
#  ORB EXECUTOR
# ══════════════════════════════════════════════════════════════════════════════

class ORBExecutor:

    def __init__(self, execution_mode: str = "PAPER", vix_cache: VIXCache = None):
        self.execution_mode = execution_mode.upper()
        self.active_trade   = None
        self._vix_cache     = vix_cache or VIXCache()
        log.info(f"[ORBExecutor] Mode: {self.execution_mode}")

    def _option_entry(self, signal: dict) -> dict | None:
        """Compute option pricing and build trade record."""
        spot      = signal["spot"]
        direction = signal["direction"]
        today     = date.today()
        expiry    = next_thursday(today)
        dte       = (expiry - today).days
        T         = max(dte / 365, 1 / 365)
        strike    = atm_strike(spot)
        vix_val   = self._vix_cache.get()
        iv        = iv_surface(spot, strike, dte, vix_val, direction)

        price, delta, gamma, theta, vega = bs_price(
            spot, strike, T, C.RISK_FREE, iv, direction
        )

        if price <= 0:
            log.warning(f"[ORBExecutor] Option price = 0 — skip entry")
            return None

        size_mult = C.PE_SIZE_MULT if direction == "PE" else C.CE_SIZE_MULT
        lots      = max(1, int(C.CAPITAL_PER_TRADE * size_mult / (price * C.LOT_SIZE)))
        units     = lots * C.LOT_SIZE
        cost      = price * units
        entry_ts  = now_ist()

        # Compute spot SL level
        sl_spot_level = (
            round(spot * (1 - C.SL_SPOT_PCT / 100), 2) if direction == "CE"
            else round(spot * (1 + C.SL_SPOT_PCT / 100), 2)
        )

        trade = {
            "trade_id":            str(uuid.uuid4()),
            "execution_mode":      self.execution_mode,
            "trade_date":          today,
            "direction":           direction,
            "regime":              signal["regime"],
            "orb_high":            signal["orb_high"],
            "orb_low":             signal["orb_low"],
            "orb_range_pct":       round(signal["orb_range_pct"], 4),
            "atr_pct_at_entry":    round(signal["atr_pct"], 4),
            "prior_day_range_pct": round(signal["prior_day_range_pct"], 4),
            "entry_time":          entry_ts,
            "strike":              strike,
            "expiry":              expiry,
            "dte_at_entry":        dte,
            "spot_entry":          round(spot, 2),
            "sl_spot_level":       sl_spot_level,
            "vix_on_entry":        round(vix_val, 2),
            "iv_entry_pct":        round(iv * 100, 2),
            "premium_entry":       round(price, 2),
            "lots":                lots,
            "units":               units,
            "cost_outflow":        round(cost, 2),
            "delta_entry":         round(delta, 4),
            "gamma_entry":         round(gamma, 6),
            "theta_entry_per_day": round(theta * units, 2),
            "vega_entry_per_1pct": round(vega * units, 2),
        }
        return trade

    def enter(self, signal: dict):
        """Enter a new paper trade."""
        if self.active_trade:
            log.warning("[ORBExecutor] Already in trade — skipping entry")
            return

        trade = self._option_entry(signal)
        if not trade:
            return

        insert_orb_trade(trade)
        self.active_trade = trade

        log.info(
            f"[ORBExecutor] 🟩 [{self.execution_mode}] ENTER {trade['direction']} "
            f"| strike={trade['strike']} exp={trade['expiry']} "
            f"| spot={trade['spot_entry']:.2f} premium=₹{trade['premium_entry']:.2f} "
            f"| lots={trade['lots']} cost=₹{trade['cost_outflow']:,.0f} "
            f"| δ={trade['delta_entry']:.3f} θ=₹{trade['theta_entry_per_day']:.0f}/day"
        )

    def monitor(self, df: pd.DataFrame):
        """Check SL and time exit on active trade."""
        if not self.active_trade:
            return

        t     = ist_time()
        today = date.today()

        today_df = df[df.index.date == today]
        if today_df.empty:
            return

        latest_spot  = float(today_df["close"].iloc[-1])
        spot_entry   = float(self.active_trade["spot_entry"])
        direction    = self.active_trade["direction"]
        trade_id     = self.active_trade["trade_id"]
        expiry       = self.active_trade["expiry"]

        # Spot move against position
        move_pct = (latest_spot - spot_entry) / spot_entry * 100
        if direction == "PE":
            move_pct = -move_pct   # PE profits when spot falls

        sl_hit = move_pct <= -C.SL_SPOT_PCT
        exit_eod = t >= C.EXIT_TIME

        if not sl_hit and not exit_eod:
            # Log current position status every cycle
            log.debug(
                f"[ORBExecutor] {direction} | spot={latest_spot:.2f} "
                f"move={move_pct:+.3f}% | SL@{-C.SL_SPOT_PCT:.2f}%"
            )
            return

        # ── EXIT ─────────────────────────────────────────────────────────────
        dte_exit = max((expiry - today).days, 0)
        T_exit   = max(dte_exit / 365, 1 / 365)
        iv_exit  = iv_surface(
            latest_spot,
            self.active_trade["strike"],
            dte_exit,
            self._vix_cache.get(),
            direction,
        )
        price_exit, _, _, _, _ = bs_price(
            latest_spot, self.active_trade["strike"],
            T_exit, C.RISK_FREE, iv_exit, direction
        )

        units      = self.active_trade["units"]
        pnl        = (price_exit - self.active_trade["premium_entry"]) * units
        pnl_pct    = (price_exit - self.active_trade["premium_entry"]) / \
                     self.active_trade["premium_entry"] * 100
        spot_chg   = (latest_spot - spot_entry) / spot_entry * 100
        exit_ts    = now_ist()
        status     = "SL_HIT" if sl_hit else "CLOSED"

        exit_data = {
            "exit_time":    exit_ts,
            "spot_exit":    round(latest_spot, 2),
            "spot_chg_pct": round(spot_chg, 4),
            "premium_exit": round(price_exit, 2),
            "iv_exit_pct":  round(iv_exit * 100, 2),
            "pnl":          round(pnl, 2),
            "pnl_pct":      round(pnl_pct, 2),
            "sl_hit":       sl_hit,
            "exit_reason":  "SL_HIT" if sl_hit else "EOD_EXIT",
        }
        close_orb_trade(trade_id, exit_data)

        emoji = "🔴" if pnl < 0 else "🟢"
        reason = "SL HIT" if sl_hit else "EOD EXIT"
        log.info(
            f"[ORBExecutor] {emoji} [{self.execution_mode}] {reason} {direction} "
            f"| spot={latest_spot:.2f} premium_exit=₹{price_exit:.2f} "
            f"| PnL=₹{pnl:,.0f} ({pnl_pct:+.1f}%)"
        )
        self.active_trade = None


# ══════════════════════════════════════════════════════════════════════════════
#  MAIN LOOP
# ══════════════════════════════════════════════════════════════════════════════

def main(execution_mode: str = "PAPER"):
    log.info("=" * 60)
    log.info(f"  Nifty ORB Options Executor  [{execution_mode}]")
    log.info("=" * 60)

    create_tables()

    vix_cache     = VIXCache()
    signal_engine = ORBSignal()
    executor      = ORBExecutor(execution_mode, vix_cache=vix_cache)

    # Restore any open trade from DB (handles restarts)
    open_trade = get_open_orb_trade(execution_mode)
    if open_trade:
        executor.active_trade = dict(open_trade)
        log.info(
            f"[Main] Restored open trade from DB: "
            f"{open_trade['direction']} entered at {open_trade['entry_time']}"
        )

    log.info(f"[Main] Polling every {C.POLL_INTERVAL_SEC}s. NIFTY50.parquet → {C.NIFTY_PARQUET}")

    while True:
        try:
            t = ist_time()

            # Outside market hours — sleep longer
            if t < C.MARKET_OPEN or t > C.EXIT_TIME:
                time.sleep(30)
                continue

            # Refresh VIX from Kite into memory
            vix_cache.refresh()

            # Load latest candles
            df = load_nifty_candles()
            if df.empty:
                log.warning("[Main] Empty candle data — retrying...")
                time.sleep(C.POLL_INTERVAL_SEC)
                continue

            # Monitor active trade first
            executor.monitor(df)

            # Check for new signal (only if no active trade)
            if not executor.active_trade:
                signal = signal_engine.check(df)
                if signal:
                    executor.enter(signal)

        except KeyboardInterrupt:
            log.info("[Main] Shutting down.")
            break
        except Exception as e:
            log.error(f"[Main] Unhandled error: {e}", exc_info=True)

        time.sleep(C.POLL_INTERVAL_SEC)


if __name__ == "__main__":
    mode = sys.argv[1].upper() if len(sys.argv) > 1 else "PAPER"
    if mode not in ("PAPER", "LIVE"):
        print("Usage: python3 -m orb_strategy.run_orb [paper|live]")
        sys.exit(1)
    main(mode)
