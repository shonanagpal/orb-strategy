# orb_strategy/run_orb.py
#
# ORB Options Paper Executor
#
# Reads NIFTY50.parquet from the existing assembled_candles pipeline.
# Checks ORB signal + filters every POLL_INTERVAL_SEC seconds.
# Manages entry, SL monitoring, and 15:15 exit.
# Writes all trades to orb_trades table in same Postgres.
#
# Usage:
#   cd /home/shona_nagpal/trading/Bollinger
#   python3 -m orb_strategy.run_orb [paper|live]
#
# tmux:
#   tmux new-session -d -s orb 'cd ~/trading/Bollinger && python3 -m orb_strategy.run_orb paper'

